# Resume Agent 环境配置
# 使用方式：复制本文件为 .env，然后填写你的配置
# cp .env.example .env

# 必填：DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-api-key-here

# 可选：自定义 Base URL（默认 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：自定义模型（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# MCP 服务器配置（通过 settings.json 配置，此处仅列出参考）
# ---------------------------------------------------------------------------

# PDF 转换 MCP 服务（默认 localhost:9100）
# PDF_MCP_HOST=127.0.0.1
# PDF_MCP_PORT=9100

# 邮件发送 MCP 服务（默认 localhost:9101）
# EMAIL_MCP_HOST=127.0.0.1
# EMAIL_MCP_PORT=9101

# SMTP 配置（邮件 MCP 服务使用）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=your@email.com

# ---------------------------------------------------------------------------
# 速率限制配置（通过 settings.json 配置，此处仅列出参考）
# ---------------------------------------------------------------------------

# 每用户每分钟请求限制（默认 20）
# RATE_LIMIT_RPM=20
# 速率限制最大等待时间秒（默认 5.0）
# RATE_LIMIT_MAX_WAIT=5.0

# ---------------------------------------------------------------------------
# 监控配置（通过 settings.json 配置，此处仅列出参考）
# ---------------------------------------------------------------------------

# 监控日志汇总间隔秒（默认 60）
# MONITOR_LOG_INTERVAL=60
